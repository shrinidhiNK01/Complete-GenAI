    {
      "chunk_id": "llmops_notes:chunk:1",
      "doc_id": "llmops_notes",
      "text": "# LLMOps Notes Production RAG systems should log request id, user or tenant id, prompt version, model name, retrieval chunk ids, latency, token usage, errors, and safety decisions. Production systems should not log API keys, passwords, or private personal data unless there is a clear legal reason and strong protection. Evaluation should check answer correctness, faithfulness, retrieval relevance, source accuracy, latency, and cost.",
      "start_word": 0,
      "end_word": 63,
      "metadata": {
        "source": "C:\\Users\\Shrinidhi N K\\Documents\\Codex\\2026-07-09\\with-multiple-project-deploayment-steps-multiple\\outputs\\genai-complete-implementation-course\\projects\\advanced_rag_llmops\\data\\sample_docs\\llmops_notes.md",
        "file_name": "llmops_notes.md",
        "suffix": ".md"
      }
    },
    {
      "chunk_id": "refund_policy:chunk:1",
      "doc_id": "refund_policy",
      "text": "Refund Policy Customers can request a refund within 30 days of purchase. A valid proof of purchase is required for every refund request. Refunds are returned to the original payment method when possible. Refunds are not available for damaged products caused by misuse. If the product arrived damaged, the customer should contact support with photos and the order number.",
      "start_word": 0,
      "end_word": 59,
      "metadata": {
        "source": "C:\\Users\\Shrinidhi N K\\Documents\\Codex\\2026-07-09\\with-multiple-project-deploayment-steps-multiple\\outputs\\genai-complete-implementation-course\\projects\\advanced_rag_llmops\\data\\sample_docs\\refund_policy.txt",
        "file_name": "refund_policy.txt",
        "suffix": ".txt"
      }
    },
    {
      "chunk_id": "shipping_policy:chunk:1",
      "doc_id": "shipping_policy",
      "text": "Shipping Policy Standard shipping takes 3 to 5 business days after the order is processed. Express shipping takes 1 to 2 business days. International shipping times depend on customs and destination country. Customers receive a tracking link by email after the package leaves the warehouse.",
      "start_word": 0,
      "end_word": 45,
      "metadata": {
        "source": "C:\\Users\\Shrinidhi N K\\Documents\\Codex\\2026-07-09\\with-multiple-project-deploayment-steps-multiple\\outputs\\genai-complete-implementation-course\\projects\\advanced_rag_llmops\\data\\sample_docs\\shipping_policy.txt",
